    title: "A Method of Sequential Log-Convex Programming for Engineering Design"
    authors:
      - family-names: Karcher
        given-names: Cody
      - family-names: Haimes
        given-names: Robert
    journal: "Optimization and Engineering"
    year: 2022
    doi: "10.1007/s11081-022-09750-3"
